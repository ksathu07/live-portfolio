{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLARA Config v1",
  "type": "object",
  "required": ["agent", "owner", "sources", "projectDirectories", "paths", "trust"],
  "properties": {
    "agent": { "type": "object", "properties": { "name": { "type": "string" }, "role": { "type": "string" } } },
    "owner": { "type": "object", "required": ["github_username"], "properties": {
      "name": { "type": "string" },
      "github_username": { "type": "string" },
      "email": { "type": "string" }
    }},
    "sources": { "type": "object", "properties": {
      "personalFolder": { "type": "string" },
      "projectRoot": { "type": "string" },
      "linkedinExport": { "type": ["string", "null"] },
      "instagramExport": { "type": ["string", "null"] }
    }},
    "projectDirectories": { "type": "array", "items": { "type": "string" }, "description": "Directories under projectRoot that belong to the owner." },
    "excludeProjectNames": { "type": "array", "items": { "type": "string" } },
    "paths": { "type": "object", "properties": {
      "snapshots": { "type": "string" },
      "proposed": { "type": "string" },
      "profile": { "type": "string" },
      "portfolioContent": { "type": "string" },
      "cvs": { "type": "string" }
    }},
    "deploy": { "type": "object", "properties": { "provider": { "type": "string" }, "workingDirectory": { "type": "string" } } },
    "trust": { "type": "object", "properties": {
      "requireApprovalBeforePublish": { "type": "boolean" },
      "approvalTimeoutDays": { "type": "number" },
      "allowedPublishStates": { "type": "array", "items": { "type": "string" } }
    }}
  }
}