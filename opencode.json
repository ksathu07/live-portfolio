{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "clara",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "git checkout*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "Remove-Item*": "ask",
      "rm -rf*": "ask"
    },
    "external_directory": {
      "*": "deny",
      "D:/Personal Info/**": "allow",
      "D:/Projects/**": "allow"
    }
  }
}
